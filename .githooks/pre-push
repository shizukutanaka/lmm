#!/usr/bin/env bash
# lmm pre-push hook -- never let a broken hub reach the remote.
#
# Philosophy: measure, don't trust. At push time the change is already
# COMMITTED, so we test the exact REVISION being pushed -- not the working
# tree, which may contain unpushed edits that mask or cause a failure.
#
# This used to extract each changed .py file and run its selftest as a lone
# blob. That premise died when lmm became three files that import each other:
# a lone lmm.py exits 1 by design (missing siblings), so the old hook blocked
# every push -- and only ran at all on one specific machine, because it
# hardcoded that machine's temp directory. A git worktree checks out the
# pushed revision as a complete tree into a portable temp dir, and running
# from inside it needs no path translation on MSYS either.
#
# Bypass (explicit override, per self-edit-gate convention):
#   LMM_SKIP_HOOK=1 git push ...
set -u

if [ "${LMM_SKIP_HOOK:-0}" = "1" ]; then
  echo "[pre-push] LMM_SKIP_HOOK=1 -- guard bypassed (explicit override)." >&2
  exit 0
fi

status=0
tested=""
# pre-push receives lines: <local-ref> <local-sha> <remote-ref> <remote-sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  # Deleting a remote branch pushes the zero sha; nothing to test.
  case "${local_sha}" in 0000000000000000000000000000000000000000) continue ;; esac
  # Several refs can point at the same commit; prove each revision once.
  case " ${tested} " in *" ${local_sha} "*) continue ;; esac
  tested="${tested} ${local_sha}"

  echo "[pre-push] self-proof of the exact pushed revision ${local_sha:0:8}:" >&2
  tmpdir=$(mktemp -d 2>/dev/null) || { echo "[pre-push] mktemp failed; skipping guard." >&2; continue; }
  if ! git worktree add --detach --quiet "${tmpdir}" "${local_sha}" 2>/dev/null; then
    rm -rf "${tmpdir}"
    echo "[pre-push] could not check out ${local_sha:0:8}; skipping guard." >&2
    continue
  fi
  if ! (cd "${tmpdir}" && LMM_SELFTEST_SKIP_LIVE=1 python lmm.py selftest --guard); then
    echo "[pre-push] BLOCKED: revision ${local_sha:0:8} failed its own selftest." >&2
    echo "[pre-push] Fix the code (or run: LMM_SKIP_HOOK=1 git push to override) then re-push." >&2
    status=1
  fi
  git worktree remove --force "${tmpdir}" 2>/dev/null || rm -rf "${tmpdir}"
done

exit "${status}"
